{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Servir Clinica (PHP en localhost:8000)",
      "detail": "Levanta el servidor PHP integrado apuntando a esta carpeta",
      "type": "shell",
      "command": "C:\\xampp\\php\\php.exe",
      "args": ["-S", "localhost:8000", "-t", "."],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Abrir Clinica en el navegador",
      "type": "shell",
      "command": "start http://localhost:8000/index.php",
      "problemMatcher": []
    }
  ]
}
